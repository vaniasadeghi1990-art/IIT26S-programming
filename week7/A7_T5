DELIMITER = ";"
WEEKDAYS = ("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturnday", "Sunday",)


class TIMESTAMP:
    weekday = ""
    hour = ""
    consumption = 0.0
    price = 0.0


class DAY_USAGE:
    weekday = ""
    usage = 0.0
    cost = 0.0


def readFile(PFilename: str, PTimestamps: list[TIMESTAMP]) -> None:
    print('Reading file "{}".'.format(PFilename))
    PTimestamps.clear()
    Filehandle = open(PFilename, "r", encoding="utf-8")
    FirstLine = True
    for Line in Filehandle:
        if FirstLine:
            FirstLine = False
            continue
        Row = Line.rstrip()
        if Row == "":
            continue
        Columns = Row.split(DELIMITER)
        Timestamp = TIMESTAMP()
        Timestamp.weekday = Columns[0]
        Timestamp.hour = Columns[1]
        Timestamp.consumption = float(Columns[2])
        Timestamp.price = float(Columns[3])
        PTimestamps.append(Timestamp)
        Columns.clear()
    Filehandle.close()
    return None


def analyseTimestamps(PTimestamps: list[TIMESTAMP], PResults: list[str]) -> None:
    print("Analysing timestamps.")
    Days: list[DAY_USAGE] = []
    for Name in WEEKDAYS:
        Day = DAY_USAGE()
        Day.weekday = Name
        Day.usage = 0.0
        Day.cost = 0.0
        Days.append(Day)
    for Timestamp in PTimestamps:
        for Day in Days:
            if Timestamp.weekday == Day.weekday:
                Day.usage += Timestamp.consumption                       # gatherer
                Day.cost += Timestamp.consumption * Timestamp.price      # gatherer
    for Day in Days:
        PResults.append(" - {} usage {:.2f} kWh, cost {:.2f} €".format(Day.weekday, Day.usage, Day.cost))
    Days.clear()
    return None


def displayResults(PResults: list[str]) -> None:
    print("Displaying results.")
    print("### Electricity consumption summary ###")
    for Result in PResults:
        print(Result)
    print("### Electricity consumption summary ###")
    return None


def main() -> None:
    print("Program starting.")
    Timestamps: list[TIMESTAMP] = []
    Results: list[str] = []
    Filename = input("Insert filename: ")
    readFile(Filename, Timestamps)
    analyseTimestamps(Timestamps, Results)
    displayResults(Results)
    Timestamps.clear()
    Results.clear()
    print("Program ending.")
    return None


main()